# Copy this file to ".env" (same folder) for local development, or set these
# same values in Vercel's dashboard (Project → Settings → Environment
# Variables) for production. Never commit the real ".env" file — it's
# already excluded in .gitignore.

# --- Required in production, optional locally ---------------------------
# Without these, the app falls back to local SQLite + local media/ folder,
# which is exactly how it already worked before this deployment setup.

# Postgres connection string from Neon / Supabase, e.g.:
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Cloudinary connection string, from your Cloudinary dashboard's "API
# Environment variable" box, e.g.:
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# --- Django settings ------------------------------------------------------

# A long random string, unique to this deployment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# "False" in production. Leave unset (defaults to True) for local dev.
DJANGO_DEBUG=False

# Comma-separated list of domains this site is allowed to serve, e.g.:
# your-project-name.vercel.app
DJANGO_ALLOWED_HOSTS=

# Comma-separated list of full origins (with https://) allowed to submit
# forms to this site, e.g.:
# https://your-project-name.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=
