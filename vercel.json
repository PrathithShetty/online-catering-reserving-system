{
  "version": 2,
  "builds": [
    {
      "src": "backend/catering_system/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "20mb" }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "backend/catering_system/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "backend/catering_system/wsgi.py"
    }
  ]
}
